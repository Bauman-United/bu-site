{
  "name": "bu-web",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:robots": "node scripts/check-no-prerendered-robots.mjs",
    "e2e": "playwright test",
    "e2e:empty": "playwright test -c playwright.empty.config.ts",
    "gen:api": "openapi-typescript openapi.json -o src/lib/api-types.ts"
  },
  "dependencies": {
    "@fontsource/oswald": "^5.3.0",
    "next": "16.3.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.9.0",
    "schema-dts": "^1.1.5",
    "typescript": "^5.8",
    "vitest": "^3.2.0"
  }
}
