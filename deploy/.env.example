# Скопировать в deploy/.env и заполнить. Файл .env в git не попадает.
TAG=latest
IMAGE_PREFIX=ghcr.io/bauman-united

# Режим nginx: http (до домена), https (после выпуска сертификата)
# или edge — 80/443 держит общий Caddy сервера (см. docker-compose.edge.yml)
NGINX_MODE=http
SITE_DOMAIN=example.ru
# Только для edge:
# COMPOSE_FILE=docker-compose.yml:docker-compose.edge.yml
# CADDY_SITES_DIR=/opt/caddy-sites
# CADDY_CONTAINER=protein-caddy-1

POSTGRES_PASSWORD=change-me-long-random

BU_SITE_URL=http://127.0.0.1
BU_NOINDEX=1
BU_REVALIDATE_SECRET=change-me-long-random
BU_TELEGRAM_BOT_TOKEN=
BU_TELEGRAM_CHAT_ID=
# Куда бот шлёт заявки «Хочу в команду» (chat id владельца); пусто — в BU_TELEGRAM_CHAT_ID
BU_JOIN_CHAT_ID=

# Источники LFL (JSON-массивы в переменных pydantic-settings)
BU_LFL_CLUB_ID=14270
BU_LFL_TOURNAMENT_IDS=["32573","33238"]

# Бэкапы в Timeweb S3
S3_ENDPOINT=https://s3.twcstorage.ru
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
