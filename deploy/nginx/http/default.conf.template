gzip on;
gzip_types text/css application/javascript application/json image/svg+xml application/xml text/plain;
server_tokens off;
# Docker DNS: заново резолвим web после пересоздания контейнера при деплое.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80 default_server;
    server_name _;
    client_max_body_size 2m;

    location /.well-known/acme-challenge/ { root /var/www/certbot; }

    location /_next/static/ {
        set $web_upstream http://web:3000;
        proxy_pass $web_upstream;
        include /etc/nginx/common/proxy.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        set $web_upstream http://web:3000;
        proxy_pass $web_upstream;
        include /etc/nginx/common/proxy.conf;
    }
}
